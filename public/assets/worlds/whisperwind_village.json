  "npcs": [
    { "id": "arlo", "name": "Arlo", "x": 2360, "y": 2260, "face": "down", "color": "#f0bf7d", "outfit": "#368fc9", "dialogue": ["Welcome to Whisperwind. This is where the Forge starts feeling like a place instead of a menu.", "The plaza leads north to Echo Hall, west to the store and tavern, east to the board and homes, and south toward the docks."] },
    { "id": "brindle", "name": "Brindle", "x": 930, "y": 1580, "face": "right", "color": "#ddb079", "outfit": "#8b5cf6", "dialogue": ["Empty cottages can be claimed right now.", "Later, we should add price, resale value, furniture score, and permissions for friends or guilds."] },
    { "id": "marina", "name": "Marina", "x": 4280, "y": 3370, "face": "right", "color": "#f3c38a", "outfit": "#0ea5a3", "dialogue": ["The river is the first thing that should feel alive. Watch the shimmer near the dock.", "When fishing comes back here, it should feel like part of town instead of a separate screen."] },
    { "id": "cog", "name": "Professor Cog", "x": 2890, "y": 1250, "face": "down", "color": "#e8b98b", "outfit": "#d97706", "dialogue": ["Echo Hall is not merely a building. It is where games become places.", "One day you will walk inside and choose a table instead of clicking a menu."] },
    { "id": "luma", "name": "Luma", "x": 1110, "y": 2880, "face": "up", "color": "#f2c4a0", "outfit": "#be185d", "dialogue": ["The Blue Lantern is open. Sort of.", "For now it is a placeholder, but it should become the place to find groups, rumors, and player-made parties."] }
