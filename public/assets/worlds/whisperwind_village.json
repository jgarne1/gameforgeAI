  "npcs": [
    { "id": "arlo", "name": "Arlo", "x": 2360, "y": 2260, "face": "down", "interact": { "label": "Talk to Arlo", "radius": 110 }, "dialogue": ["Welcome to Whisperwind. This is where the Forge starts feeling like a place instead of a menu.", "The plaza leads north to Echo Hall, west to the store, east to the board, and down toward the docks."] },
    { "id": "brindle", "name": "Brindle", "x": 930, "y": 1580, "face": "right", "interact": { "label": "Talk to Brindle", "radius": 110 }, "dialogue": ["We are not selling dirt plots anymore. Empty cottages are easier to understand.", "Claim one for testing, then we will build interiors and furniture placement next."] },
    { "id": "marina", "name": "Marina", "x": 4280, "y": 3370, "face": "right", "interact": { "label": "Talk to Marina", "radius": 110 }, "dialogue": ["The river is the first thing that should feel alive. Watch the shimmer near the dock.", "When fishing comes back here, it should feel like part of town instead of a separate screen."] },
    { "id": "cog", "name": "Professor Cog", "x": 2890, "y": 1250, "face": "down", "interact": { "label": "Talk to Cog", "radius": 110 }, "dialogue": ["Echo Hall is not merely a building. It is where games become places.", "One day you will walk inside and choose a table instead of clicking a menu."] }
