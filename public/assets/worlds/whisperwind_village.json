    { "id": "town_fountain", "type": "fountain", "x": 1110, "y": 835, "r": 95, "label": "Town Fountain", "text": "The fountain hums softly with Forge energy. Players gather here when the village is busy." },
    { "id": "town_board", "type": "board", "x": 950, "y": 1005, "r": 90, "label": "Town Board", "title": "Whisperwind Board", "text": "Welcome to Whisperwind Village. Current goals: test multiplayer movement, claim a plot, talk to NPCs, and make this town feel alive." },

    { "id": "arlo", "type": "npc", "sprite": "arlo", "name": "Arlo", "x": 1010, "y": 910, "r": 90, "dialogue": ["There you are! Whisperwind is still waking up, but the streets are real enough to get lost in.", "Try walking to a plot sign, the board, or the dock. The town should teach you by being a town, not by yelling arrows at you." ] },
    { "id": "brindle", "type": "npc", "sprite": "brindle", "name": "Brindle", "x": 820, "y": 740, "r": 90, "dialogue": ["Plots, doors, mailboxes, signs — all of it needs to be editable. A pretty town that cannot be changed is just wallpaper.", "We will start with claimable starter plots, then grow into real home interiors and furniture placement." ] },
    { "id": "marina", "type": "npc", "sprite": "marina", "name": "Marina", "x": 1580, "y": 1080, "r": 90, "dialogue": "The dock belongs to everyone. When the water system is folded into this engine, fishing should feel like part of the village instead of a separate screen." },
    { "id": "cog", "type": "npc", "sprite": "cog", "name": "Professor Cog", "x": 1465, "y": 690, "r": 90, "dialogue": "Echo Hall will let games become places. Walk in, choose a table, and suddenly board games feel like part of the world." },

