  "npcs": [
    { "id": "arlo", "name": "Arlo", "x": 3880, "y": 3490, "dialogue": ["This is the new production scaffold for Whisperwind.", "The buildings, trees, dock, and signs are now atlas objects. We can replace them with GameForge originals one at a time without changing the map system."], "interact": { "label": "Talk to Arlo", "radius": 115 } },
    { "id": "brindle", "name": "Brindle", "x": 2100, "y": 2850, "dialogue": ["These plots are real data points. Claim one and the scene renders a cottage from the plot state.", "That is how we get housing without painting a new background every time someone builds."], "interact": { "label": "Talk to Brindle", "radius": 115 } },
    { "id": "marina", "name": "Marina", "x": 4980, "y": 3160, "dialogue": ["The river should feel alive now. It still needs custom GameForge water, but the engine supports moving water layers and shore lines."], "interact": { "label": "Talk to Marina", "radius": 115 } },
    { "id": "cog", "name": "Cog", "x": 2500, "y": 1760, "dialogue": ["The important change is atlas rendering: every object can come from a spritesheet source rectangle.", "That means asset packs can be organized cleanly while we replace landmarks with custom art."], "interact": { "label": "Talk to Cog", "radius": 115 } }
